};
function GenerateSmartrrBundle(externalBundleInformation, $externalBundleLocation, bundleConfig = {}) {
  bundleConfig.shouldLog = bundleConfig.shouldLog || false;
  bundleConfig.chosenPack = bundleConfig.chosenPack || "";
  bundleConfig.chosenProducts = bundleConfig.chosenProducts || [];
  function Log(...data) { if (bundleConfig.shouldLog) console.log(...data); }
  class sh {
    static qs($obj, term) { const ret = $obj.querySelector(term); if (ret) return ret; throw Error(`Query Selector Failed for "${term}".`); }
    static qsd($obj, term, value = null) { let ret = null; if (value) { ret = $obj.querySelector(`[${term}="${value}"]`); if (ret) return ret; throw Error(`QuerySelector failed for "[${term}="${value}"]".`); } else { ret = $obj.querySelector(`[${term}]`); if (ret) return ret; throw Error(`QuerySelector failed for "[${term}]"`); } }
    static checkqsd($obj, term, value = null) { return value ? $obj.querySelector(`[${term}="${value}"]`) : $obj.querySelector(`[${term}]`); }
    static qsa($obj, term) { return Array.from($obj.querySelectorAll(term)); }
    static qsad($obj, term, value = null) { return value ? Array.from($obj.querySelectorAll(`[${term}="${value}"]`)) : Array.from($obj.querySelectorAll(`[${term}]`)); }
    static containsClass($objOrArr, classToCheck) { if (Array.isArray($objOrArr)) { for (let obj of $objOrArr) { if (!obj.classList.contains(classToCheck)) return false; } return true; } else { return $objOrArr.classList.contains(classToCheck); } }
    static updateClassList($objOrArr, funcToUse, classToUpdate) { if (!["add", "remove", "toggle"].includes(funcToUse)) throw Error("ClassList updated only supports Add/Remove/Toggle."); if (Array.isArray($objOrArr)) { $objOrArr.forEach(obj => obj.classList[funcToUse](classToUpdate)); } else { $objOrArr.classList[funcToUse](classToUpdate); } }
    static addClass($objOrArr, classToAdd) { sh.updateClassList($objOrArr, "add", classToAdd); }
    static removeClass($objOrArr, classToRemove) { sh.updateClassList($objOrArr, "remove", classToRemove); }
    static hide($objOrArr) { sh.addClass($objOrArr, ct.HIDE); }
    static show($objOrArr) { sh.removeClass($objOrArr, ct.HIDE); }
    static removeThenAddClass($objOrArrRemoval, $objOrArrAddition, classToToggle) { sh.removeClass($objOrArrRemoval, classToToggle); sh.addClass($objOrArrAddition, classToToggle); }
    static addHTML(element, s) { element.insertAdjacentHTML("beforeend", s); }
    static seq(a, b) { return String(a) === String(b); }
    static getAttribute($obj, attr) { return $obj.getAttribute(attr); }
    static getAttributes($objOrArr, attr) { return $objOrArr.map($obj => $obj.getAttribute(attr)); }
    static eventListener($objOrArr, event, func) { if (Array.isArray($objOrArr)) { $objOrArr.forEach(obj => obj.addEventListener(event, func)); } else { $objOrArr.addEventListener(event, func); } }
    static click($objOrArr, func) { sh.eventListener($objOrArr, "click", func); }
    static change($objOrArr, func) { sh.eventListener($objOrArr, "change", func); }
  }
  const ct = { HIDE: "smartrr-hide", ACTIVE: "smartrr-active", OPEN: "smartrr-open", CLOSE: "smartrr-close", EMPTY: "smartrr-empty", MODALOPEN: "smartrr-modal-open" };
  const qt = {
    BUNDLECONTAINERTAG: "data-smartrr-bundle-container",
    BUNDLEHEADERTAG: "data-smartrr-bundle-header",
    BUNDLEHEADER: { LABELTAG: "data-smartrr-bundle-header-label", CLOSETAG: "data-smartrr-bundle-header-close" },
    PACKSELECTIONTAG: "data-smartrr-bundle-pack-selection",
    PACKSELECTION: { HEADERTAG: "data-smartrr-bundle-pack-selection-header", PACKCONTAINERTAG: "data-smartrr-bundle-pack-container", PACKTAG: "data-smartrr-bundle-pack", PACK: { CTATAG: "data-smartrr-bundle-pack-cta", NAMETAG: "data-smartrr-bundle-pack-name", DESCRIPTIONTAG: "data-smartrr-bundle-pack-description" }, SELECTIONCHANGETAG: "data-smartrr-bundle-pack-selection-change" },
    PRODUCTSELECTIONTAG: "data-smartrr-product-selection",
    PRODUCTSELECTION: { HEADERTAG: "data-smartrr-product-selection-header", HEADER: { FILTERTAG: "data-smartrr-psh-filter", FILTER: { LABELTAG: "data-smartrr-psh-filter-label", TAGSLISTTAG: "data-smartrr-psh-filter-tags", TAGSLIST: { INDIVIDUALTAG: "data-smartrr-psh-filter-tag" } }, SEARCH: { CONTAINERTAG: "data-smartrr-product-selection-search-container", SEARCHINPUTTAG: "data-smartrr-product-selection-search", MOBILECTATAG: "data-smartrr-product-search-mobile-cta" } }, SELECTIONTAG: "data-smartrr-product-selection-list", SELECTION: { CARDTAG: "data-smartrr-psl-card", CARDPRODUCTTAG: "data-smartrr-psl-card-product", EMPTYSEARCH: "data-smartrr-psl-empty" } },
    PRODUCTCARD: { IMAGETAG: "data-smartrr-psl-card-image", IMAGEDEFAULTTAG: "data-smartrr-image-default", CTATAG: "data-smartrr-psl-card-cta", CTA: { MINUSTAG: "data-smartrr-plsc-cta-minus", VALUETAG: "data-smartrr-plsc-cta-value", PLUSTAG: "data-smartrr-plsc-cta-plus", ATCTAG: "data-smartrr-plsc-cta-atc" }, NAMETAG: "data-smartrr-psl-card-name" },
    CARTINFOTTAG: "data-smartrr-cart-info",
    CARTINFO: { BOXSELECTIONTAG: "data-smartrr-box-selection", BOXSELECTION: { PROGRESSBARTAG: "data-smartrr-box-selection-progress-bar", PROGRESSBAR: { BARTAG: "data-smartrr-bspb-bar", FULLTAG: "data-smartrr-bspb-full", CURRENTTAG: "data-smartrr-progress-current" }, CARDLISTTAG: "data-smartrr-box-selection-cards", BOXCLEARTAG: "data-smartrr-box-clear" }, PLANSELECTIONTAG: "data-smartrr-selling-plan-selection", PLANSELECTION: { HEADERTAG: "data-smartrr-ssp-header", PLANLISTTAG: "data-smartrr-ssp-plans", PLANLIST: { PLANTAG: "data-smartrr-ssp-plan" } }, CONFIRMATIONTAG: "data-smartrr-confirmation-container", CONFIRMATION: { CTATAG: "data-smartrr-confirmation-cta", CTA: { TEXTTAG: "data-smartrr-ccta-text", PRICETAG: "data-smartrr-ccta-price" } } },
    PRICEINFO: { PRICETAG: "data-smartrr-bundle-price-amount" }
  };
  class BundleLocale {
    constructor() {
      this.default = {
        bundleHeader: "Build your subscription box",
        packSelectionHeader: "Step 1 of 4: How many pairs in each box?",
        packSelectedHeader: "Step 1 of 4: How many pairs in each box?",
        packSelectionSizeChange: "Select different size",
        productSelectionFilterLabel: n => `Step 4 of 4: Select ${n} Shoe Styles`,
        productAddToCart: "Add",
        productSearchPlaceholder: "Search",
        productEmptySearch: "No Products found",
        productOutOfStock: "Out of Stock",
        cartBoxProgress: "Some items chosen",
        cartBoxFull: "Box full!",
        cartClear: "Clear all",
        cartFrequency: "Step 2 of 4: How often do you need a new box?",
        cartOneTime: "One time purchase",
        cartConfirm: "Confirm"
      };
    }
  }
  const smartrrLocale = new BundleLocale();
  function intl() {
    const locale = typeof Shopify !== "undefined" ? Shopify.locale : "default";
    return smartrrLocale[locale] || smartrrLocale.default;
  }
  class Handler {
    constructor(externalBundle, cart, $bundle) {
      this.bundle = JSON.parse(JSON.stringify(externalBundle));
      this.$loc = $bundle;
      this.cart = cart;
    }
  }
  class Cart {
    constructor() {
      this.currentNum = 0;
      this.lineItems = {};
      this.cartRefs = [];
    }
    static AddLineItem(handler, variantId, productId) {
      const c = handler.cart;
      if (c.currentNum < c.pack.maxProducts) {
        let lineItem = c.lineItems[variantId];
        if (typeof lineItem === "undefined") {
          const newProduct = Collection.GetProduct(c.pack, productId);
          const newVariant = Collection.GetCollectionVariant(c.pack, variantId);
          let imageString = "";
          if (newVariant && newVariant.image) imageString = newVariant.image;
          else if (newProduct && newProduct.image) imageString = newProduct.image;
          c.lineItems[variantId] = { product: newProduct, variant: newVariant, quantity: 1, image: imageString };
        } else {
          lineItem.quantity += 1;
        }
        c.currentNum += 1;
      }
      Cart.ShowCart(handler);
      UpdateProductSelection(handler);
    }
    static RemoveLineItem(handler, variantId) {
      const c = handler.cart;
      const lineItem = c.lineItems[variantId];
      if (typeof lineItem === "undefined") throw Error(`Remove Line Item ${variantId} that does not exist.`);
      c.currentNum -= 1;
      if (lineItem.quantity === 1) delete c.lineItems[variantId];
      else lineItem.quantity -= 1;
      Cart.ShowCart(handler);
      UpdateProductSelection(handler);
    }
    static ShowCart(handler) {
      const $cartInfo = sh.qsd(handler.$loc, qt.CARTINFOTTAG);
      const $box = sh.qsd($cartInfo, qt.CARTINFO.BOXSELECTIONTAG);
      sh.addClass($box, ct.ACTIVE);
    }
    static ClearCart(handler) {
      handler.cart.lineItems = {};
      handler.cart.currentNum = 0;
      UpdateProductSelection(handler);
    }
  }
  class ProductRef { }
  class Pack {
    constructor() {
      this.name = "";
      this.description = "";
      this.alert = "";
      this.collectionString = "";
      this.minProducts = 0;
      this.maxProducts = 0;
      this.variantSelection = "";
      this.searchFilterString = "";
      this.buyWithVariant = 0;
    }
    static GetPack(packs, name) {
      const ret = packs.find(pack => sh.seq(pack.name, name));
      if (ret) return ret;
      throw Error(`Did not find Pack: ${name}.`);
    }
    static HasPack(packs, name) {
      return !!packs.find(pack => sh.seq(pack.name, name));
    }
  }
  class Collection {
    constructor() { this.name = ""; this.products = []; }
    static GetProduct(pack, productId) {
      if (pack.collection) {
        const ret = pack.collection.products.find(product => sh.seq(product.id, productId));
        if (ret) return ret;
        throw Error(`Product ${productId} not in collection ${pack.collection.name}`);
      }
      throw Error(`Pack ${pack.name} does not contain a collection`);
    }
    static GetCollectionVariant(pack, variantId) {
      let retVariant = {};
      if (pack.collection) {
        for (const product of pack.collection.products) {
          product.variants.forEach(variant => { if (variant.id === variantId) retVariant = variant; });
        }
      }
      if (Object.keys(retVariant).length !== 0) return retVariant;
      else throw Error(`Variant ${variantId} not in collection ${pack.collection.name}`);
    }
  }
  class Product {
    constructor() {
      this.available = false;
      this.id = 0;
      this.title = "";
      this.handle = "";
      this.tags = [];
      this.variants = [];
      this.selling_plan_groups = [];
    }
    static GetVariant(product, variantSearch) {
      if (variantSearch === "") return product.variants[0];
      const ret = product.variants.find(variant => variant.title.toLowerCase().includes(variantSearch.toLowerCase()));
      if (ret) return ret;
      Log(`Did not find variant ${variantSearch} for ${product.title}`);
      return product.variants[0];
    }
  }
  function InitializeHeader($container) {
    const headerHTMLString = `
      <div data-smartrr-bundle-header>
        <div data-smartrr-bundle-header-label>
          <span>${intl().bundleHeader}</span>
        </div>
        <div data-smartrr-bundle-header-close>
          ${SVGList.headerClose}
        </div>
      </div>
    `;
    sh.addHTML($container, headerHTMLString);
    const $header = sh.qsd($container, qt.BUNDLEHEADERTAG);
    const $close = sh.qsd($header, qt.BUNDLEHEADER.CLOSETAG);
    const $modalContainer = document.querySelector("[data-smartrr-modal-container]");
    sh.click($close, function () {
      if ($modalContainer) {
        sh.removeClass($modalContainer, ct.OPEN);
        sh.removeClass(document.body, ct.MODALOPEN);
      }
    });
  }
  function initializeStep1(handler, onComplete) {
    const $step1 = document.getElementById("step1");
    $step1.innerHTML = "";
    InitializeHeader($step1);
    const packSelectionString = `
      <div data-smartrr-bundle-pack-selection>
        <div data-smartrr-bundle-pack-selection-header>
          <span>${intl().packSelectionHeader}</span>
        </div>
        <div data-smartrr-bundle-pack-container>
        </div>
      </div>
    `;
    sh.addHTML($step1, packSelectionString);
    const $packSelection = sh.qsd($step1, qt.PACKSELECTIONTAG);
    const $packContainer = sh.qsd($packSelection, qt.PACKSELECTION.PACKCONTAINERTAG);
    function VerifyPackAvailability() {
      const b = handler.bundle;
      b.packs.forEach(pack => {
        const variantId = pack.buyWithVariant;
        b.bundleProduct.variants.forEach(variant => {
          if (sh.seq(variant.id, variantId)) pack.variantAvailabe = variant.available;
        });
      });
    }
    function GeneratePacks() {
      VerifyPackAvailability();
      const b = handler.bundle;
      b.packs.forEach(pack => {
        const packAlert = pack.variantAvailabe ? pack.alert : intl().productOutOfStock;
        const packCTAString = packAlert && packAlert.length > 0
          ? `<div data-smartrr-bundle-pack-cta><span>${packAlert}</span></div>`
          : `<div data-smartrr-bundle-pack-no-cta><span>${packAlert}</span></div>`;
        const packString = `
          <div data-smartrr-bundle-pack="${btoa(pack.name)}" class="${ct.OPEN}">
            ${packCTAString}
            <div data-smartrr-bundle-pack-name class="${pack.variantAvailabe ? "" : ct.EMPTY}">
              <span>${pack.name}</span>
            </div>
            <div data-smartrr-bundle-pack-description>
              <span>${pack.description}</span>
            </div>
          </div>
        `;
        sh.addHTML($packContainer, packString);
      });
      sh.addHTML($packContainer, `
        <div data-smartrr-bundle-pack-selection-change>
          <span>
            ${SVGList.packSelectionArrow}
            <span>${intl().packSelectionSizeChange}</span>
          </span>
        </div>
      `);
    }
    GeneratePacks();
    const $packSelectionChange = sh.checkqsd($packContainer, qt.PACKSELECTION.SELECTIONCHANGETAG);
    if ($packSelectionChange) {
      sh.click($packSelectionChange, function () {
        // Show all pack elements and remove active class
        const packElements = sh.qsad($packContainer, qt.PACKSELECTION.PACKTAG);
        packElements.forEach(function (el) {
          sh.show(el);
          sh.removeClass(el, ct.ACTIVE);
        });
        // Reset the header text back to the default prompt
        const $packSelectionHeaderText = sh.qs($packSelection, `[${qt.PACKSELECTION.HEADERTAG}] span`);
        if ($packSelectionHeaderText) {
          $packSelectionHeaderText.textContent = intl().packSelectionHeader;
        }
        // Clear steps 2, 3, and 4
        document.getElementById("step2").innerHTML = "";
        document.getElementById("step3").innerHTML = "";
        document.getElementById("step4").innerHTML = "";
        // Remove any existing cart info and confirmation elements
        const existingCartInfo = handler.$loc.querySelector('[data-smartrr-cart-info]');
        if (existingCartInfo) { existingCartInfo.remove(); }
        const existingConfirmation = handler.$loc.querySelector('[data-smartrr-confirmation-container]');
        if (existingConfirmation) { existingConfirmation.remove(); }
        // Reset the cart state so the new pack selection restarts
        handler.cart.currentNum = 0;
        handler.cart.lineItems = {};
      });
    }
    const $packlist = sh.qsad($packContainer, qt.PACKSELECTION.PACKTAG);
    console.log("Rendered pack elements:", $packlist.length);
    $packlist.forEach($pack => {
      const $packName = sh.qsd($pack, qt.PACKSELECTION.PACK.NAMETAG);
      const packName = atob(sh.getAttribute($pack, qt.PACKSELECTION.PACKTAG));
      console.log("Attaching click event to pack:", packName);
      const currentPack = Pack.GetPack(handler.bundle.packs, packName);
      if (currentPack.variantAvailabe) {
        sh.click($packName, function () {
        console.log("Pack clicked:", packName);
        $packContainer.querySelectorAll(`[${qt.PACKSELECTION.PACKTAG}]`).forEach(elem => sh.hide(elem));
        sh.show($pack);
        sh.addClass($pack, ct.ACTIVE);
        const $packSelectionHeaderText = sh.qs($packSelection, `[${qt.PACKSELECTION.HEADERTAG}] span`);
        $packSelectionHeaderText.textContent = intl().packSelectedHeader;
        handler.cart.pack = Pack.GetPack(handler.bundle.packs, packName);
        // Reset the shoe size so that later steps reinitialize
        handler.cart.shoeSize = "";
        console.log("Pack Selected:", handler.cart.pack);
        onComplete();
        });
      } else {
        console.log("Pack not available:", packName);
      }
    });
  }
  function initializeStep2(handler, onComplete) {
    const $step2 = document.getElementById("step2");
    $step2.innerHTML = "";
    const frequencyString = `
      <div data-smartrr-selling-plan-selection>
        <div data-smartrr-ssp-header>
          <span>${intl().cartFrequency}</span>
        </div>
        <div data-smartrr-ssp-plans>
          ${generateFrequencyOptions(handler)}
        </div>
      </div>
    `;
    sh.addHTML($step2, frequencyString);
    const $sellingPlans = sh.qsd($step2, qt.CARTINFO.PLANSELECTIONTAG);
    sh.show($sellingPlans);
    const $plans = sh.qsad($sellingPlans, qt.CARTINFO.PLANSELECTION.PLANLIST.PLANTAG);
    console.log("Frequency options rendered:", $plans.length);
  
    $plans.forEach($plan => {
      sh.click($plan, function () {
        const newSellingPlan = sh.getAttribute($plan, qt.CARTINFO.PLANSELECTION.PLANLIST.PLANTAG);
        // update active class on plans
        sh.removeThenAddClass($plans, $plan, ct.ACTIVE);
        
        // Only update if the selling plan has really changed
        if (handler.cart.sellingPlan !== newSellingPlan) {
          handler.cart.sellingPlan = newSellingPlan;
          // If step3 and step4 have already been built, simply update prices/confirmation
          const step3 = document.getElementById("step3");
          const step4 = document.getElementById("step4");
          if (step3.innerHTML.trim() !== "" && step4.innerHTML.trim() !== "") {
            // Update price and confirmation without resetting the shoe-size selection and product selection
            UpdatePrices(handler);
            CanConfirm(handler);
          } else {
            // Otherwise, if they aren’t already rendered, reinitialize them
            document.getElementById("step3").innerHTML = "";
            document.getElementById("step4").innerHTML = "";
            initializeStep3(handler, function () {
              document.getElementById("step4").innerHTML = "";
              initializeStep4(handler);
            });
          }
        }
        // If needed, call onComplete() when you first complete step2.
        // onComplete(); 
      });
    });
    
    function generateFrequencyOptions(handler) {
      let sellingPlanListString = `<div data-smartrr-ssp-plan><span>${intl().cartOneTime}</span></div>`;
      if (handler.bundle.group) {
        handler.bundle.group.selling_plans.forEach(plan => {
          if (plan.name.includes("{{ hidden_text }}")) return;
          let planName = plan.name;
          if (plan.options.length) planName = plan.options[0].value;
          sellingPlanListString += `<div data-smartrr-ssp-plan="${plan.id}"><span>${planName}</span></div>`;
        });
      }
      return sellingPlanListString;
    }
  }

  function initializeStep3(handler, onComplete) {
    const $step3 = document.getElementById("step3");
    $step3.innerHTML = "";
    const shoeSizeString = `
        <div id="shoe-size-container" style="padding: var(--smartrr-padding-main); line-height: var(--smartrr-text-headera-lineheight); font-size: var(--smartrr-text-headera-fontsize); position: relative; border-bottom: 1px solid var(--smartrr-border-color-alternate);">
          <label for="shoe-size" style="display: flex; gap: 2rem; align-items: baseline;">
            <span>Step 3 of 4: Select Your Child's Shoe Size (US sizes)</span>
            <a href="{{ settings.size_guide }}" style="text-decoration: underline; font-size: calc(var(--smartrr-text-headera-fontsize) * 0.7);">Size Guide</a>
          </label>
          <select id="shoe-size" name="shoe-size" style="margin-top: 1rem; display: block; border: none; appearance: none; -webkit-appearance: none; -moz-appearance: none; font-size: var(--smartrr-text-general-fontsize); line-height: var(--smartrr-text-general-lineheight); text-align: center; width: fit-content; padding: var(--smartrr-padding-small) var(--smartrr-padding-main); box-shadow: 0 0 0 1px var(--smartrr-border-color-main) inset; border-radius: var(--smartrr-padding-main); font-weight: var(--smartrr-text-fontweight-bold);">
              <option value="" disabled selected>Choose a Size ▼</option>
              <option value="10.5">10.5</option>
              <option value="11">11</option>
              <option value="11.5">11.5</option>
              <option value="12">12</option>
              <option value="12.5">12.5</option>
              <option value="13">13</option>
              <option value="13.5">13.5</option>
              <option value="1">1</option>
              <option value="1.5">1.5</option>
              <option value="2">2</option>
              <option value="2.5">2.5</option>
              <option value="3">3</option>
          </select>
        </div>
      `;
    sh.addHTML($step3, shoeSizeString);
    const $shoeSizeSelect = document.getElementById("shoe-size");
    $shoeSizeSelect.addEventListener("change", function () {
      console.log("Shoe size selected:", $shoeSizeSelect.value);
      handler.cart.shoeSize = $shoeSizeSelect.value;
      const $step4 = document.getElementById("step4");
      if ($step4 && $step4.innerHTML.trim() !== "") {
        updateStep4ForShoeSize(handler, $shoeSizeSelect.value);
      } else {
        onComplete();
      }
    });
  }

  function initializeStep4(handler) {
    const $step4 = document.getElementById("step4");
    $step4.innerHTML = "";
    InitializeCart(handler);
    InitializeProductSelection(handler, $step4);
    if (handler.cart.shoeSize) {
      updateStep4ForShoeSize(handler, handler.cart.shoeSize);
    }
  }

  function updateStep4ForShoeSize(handler, shoeSize) {
    // Find the product selection container (step4)
    const $productSelection = document.querySelector('[data-smartrr-product-selection]');
    if (!$productSelection) return;

    const $productCards = $productSelection.querySelectorAll('[data-smartrr-psl-card]');
    let visibleCount = 0;
    
    $productCards.forEach(function(card) {
      const nameSpan = card.querySelector('[data-smartrr-psl-card-name] span');
      if (nameSpan) {
        let text = nameSpan.textContent || "";
        let parts = text.split("-");
        let cardSize = parts[parts.length - 1].trim();
        if (cardSize === shoeSize) {
          card.classList.remove("smartrr-hide");
          visibleCount++;
        } else {
          card.classList.add("smartrr-hide");
        }
      }
    });
    
    const $filterLabel = document.querySelector('[data-smartrr-psh-filter-label] span');
    if ($filterLabel) {
      const required = handler.cart.pack.maxProducts - handler.cart.currentNum;
      $filterLabel.textContent = `Step 4 of 4: Select ${required} Shoe Style${required > 1 ? 's' : ''}`;
    }
    
    UpdatePrices(handler);
    CanConfirm(handler);
  }

  function runSteps(handler) {
    $externalBundleLocation.innerHTML = `
      <div id="step1"></div>
      <div id="step2"></div>
      <div id="step3"></div>
      <div id="step4"></div>
    `;
    initializeStep1(handler, function () {
      console.log("Step 1 complete, moving to Step 2");
      document.getElementById("step2").innerHTML = "";
      document.getElementById("step3").innerHTML = "";
      document.getElementById("step4").innerHTML = "";
      initializeStep2(handler, function () {
        console.log("Step 2 complete, moving to Step 3");
        document.getElementById("step3").innerHTML = "";
        document.getElementById("step4").innerHTML = "";
        initializeStep3(handler, function () {
          console.log("Step 3 complete, moving to Step 4");
          document.getElementById("step4").innerHTML = "";
          initializeStep4(handler);
        });
      });
    });
  }
  function InitializeCart(handler) {
    const b = handler.bundle;
    b.packs.forEach(pack => {
      pack.collection = b.collections.find(collection => sh.seq(collection.name, pack.collectionString));
      pack.searchFilter = b.searchFilters.find(filter => sh.seq(filter.name, pack.searchFilterString));
    });
  }
  function GenerateVariant(handler, $productList, refs, variant, product) {
    const productIDString = product ? product.id : "";
    const variantIDString = variant ? variant.id : "";
    const variantTitle = variant ? variant.title : "";
    const classesString = `${ct.ACTIVE} ${variant ? "" : ct.EMPTY} commence-variant-card commence-title-${variantTitle.replace(/[^a-zA-Z0-9 ]/g, "")}`;
    const imageDefault = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=";
    let imageString = "";
    if (variant && variant.image) imageString = variant.image;
    else if (product && product.image) imageString = product.image;
    let titleString = "";
    if (variant && variant.title !== "Default Title") titleString = variant ? `${product.title} - ${variant.title}` : "";
    else titleString = variant ? `${product.title}` : "";
    const variantString = `
      <div data-smartrr-psl-card="${variantIDString}" data-smartrr-psl-card-product="${productIDString}" class="${classesString}">
        <div data-smartrr-psl-card-image>
          <a href="${variant ? variant.url : ""}" target="_blank">
            <img data-smartrr-image-default="${imageDefault}" src="${imageString}" loading="lazy"/>
          </a>
        </div>
        <div data-smartrr-psl-card-cta>
          <div data-smartrr-plsc-cta-minus><span>-</span></div>
          <div data-smartrr-plsc-cta-value="?1?">?1?</div>
          <div data-smartrr-plsc-cta-plus><span>+</span></div>
          <div data-smartrr-plsc-cta-atc class="${ct.ACTIVE}">
            <span>${intl().productAddToCart}</span>
          </div>
        </div>
        <div data-smartrr-psl-card-name><span>${titleString}</span></div>
      </div>
    `;
    sh.addHTML($productList, variantString);
    refs.$form = sh.qs($productList, `[${qt.PRODUCTSELECTION.SELECTION.CARDTAG}]:last-child`);
    const $form = refs.$form;
    refs.$plus = sh.qsd($form, qt.PRODUCTCARD.CTA.PLUSTAG);
    refs.$minus = sh.qsd($form, qt.PRODUCTCARD.CTA.MINUSTAG);
    refs.$value = sh.qsd($form, qt.PRODUCTCARD.CTA.VALUETAG);
    refs.$atc = sh.qsd($form, qt.PRODUCTCARD.CTA.ATCTAG);
    refs.$title = sh.qs($form, `[${qt.PRODUCTCARD.NAMETAG}] span`);
    refs.$image = sh.qs($form, `[${qt.PRODUCTCARD.IMAGETAG}] img`);
    sh.click(refs.$atc, function () {
      const variantId = sh.getAttribute(refs.$form, qt.PRODUCTSELECTION.SELECTION.CARDTAG);
      const productId = sh.getAttribute(refs.$form, qt.PRODUCTSELECTION.SELECTION.CARDPRODUCTTAG);
      Cart.AddLineItem(handler, Number(variantId), productId);
    });
    sh.click(refs.$plus, function () {
      const variantId = sh.getAttribute(refs.$form, qt.PRODUCTSELECTION.SELECTION.CARDTAG);
      const productId = sh.getAttribute(refs.$form, qt.PRODUCTSELECTION.SELECTION.CARDPRODUCTTAG);
      Cart.AddLineItem(handler, Number(variantId), productId);
    });
    sh.click(refs.$minus, function () {
      const variantId = sh.getAttribute(refs.$form, qt.PRODUCTSELECTION.SELECTION.CARDTAG);
      Cart.RemoveLineItem(handler, Number(variantId));
    });
  }
  function UpdateProduct(r, c, p, lineItem) {
    if (typeof lineItem === "undefined") {
      sh.addClass(r.$atc, ct.ACTIVE);
      r.$value.setAttribute(qt.PRODUCTCARD.CTA.VALUETAG, "0");
      r.$value.innerHTML = "0";
      sh.removeClass(r.$minus, ct.ACTIVE);
      sh.addClass(r.$plus, ct.ACTIVE);
    } else {
      sh.removeClass(r.$atc, ct.ACTIVE);
      r.$value.setAttribute(qt.PRODUCTCARD.CTA.VALUETAG, String(lineItem.quantity));
      r.$value.innerHTML = String(lineItem.quantity);
      sh.addClass(r.$minus, ct.ACTIVE);
      if (sh.seq(c.currentNum, p.maxProducts)) sh.removeClass(r.$plus, ct.ACTIVE);
      else sh.addClass(r.$plus, ct.ACTIVE);
    }
  }
  function UpdateProductSelection(handler) {
    const p = handler.cart.pack;
    const c = handler.cart;
    p.collection.products.forEach(product => {
      for (const variant of product.variants) {
        const lineItem = c.lineItems[variant.id];
        UpdateProduct(variant.refs, c, p, lineItem);
      }
    });
    const $cartInfo = sh.qsd(handler.$loc, qt.CARTINFOTTAG);
    const productIDs = Object.keys(c.lineItems);
    let activeCardsRemaining = p.maxProducts;
    c.cartRefs.forEach((ref, index) => {
      sh.addClass(ref.$form, ct.ACTIVE);
      const productId = productIDs[index];
      if (productId) {
        const lineItem = c.lineItems[productId];
        sh.removeClass(ref.$form, ct.EMPTY);
        activeCardsRemaining -= lineItem.quantity;
        ref.$form.setAttribute(qt.PRODUCTSELECTION.SELECTION.CARDTAG, String(lineItem.variant.id));
        ref.$form.setAttribute(qt.PRODUCTSELECTION.SELECTION.CARDPRODUCTTAG, String(lineItem.product.id));
        let imageString = "";
        if (lineItem.variant && lineItem.variant.image) imageString = lineItem.variant.image;
        else if (lineItem.product && lineItem.product.image) imageString = lineItem.product.image;
        ref.$image.src = imageString;
        let titleString = lineItem.variant && lineItem.variant.title !== "Default Title"
          ? `${lineItem.product.title} - ${lineItem.variant.title}`
          : lineItem.product.title;
        ref.$title.textContent = titleString;
        UpdateProduct(ref, c, p, lineItem);
      } else {
        if (activeCardsRemaining <= 0) sh.removeClass(ref.$form, ct.ACTIVE);
        sh.addClass(ref.$form, ct.EMPTY);
        activeCardsRemaining -= 1;
        ref.$form.setAttribute(qt.PRODUCTSELECTION.SELECTION.CARDTAG, "");
        ref.$image.src = sh.getAttribute(ref.$image, qt.PRODUCTCARD.IMAGEDEFAULTTAG);
      }
    });
    const $clearAll = sh.qsd($cartInfo, qt.CARTINFO.BOXSELECTION.BOXCLEARTAG);
    if (c.currentNum === 0) sh.addClass($clearAll, ct.HIDE);
    else sh.removeClass($clearAll, ct.HIDE);
    const $progress = sh.qsd($cartInfo, qt.CARTINFO.BOXSELECTION.PROGRESSBARTAG);
    const $span = sh.qsd($progress, qt.CARTINFO.BOXSELECTION.PROGRESSBAR.BARTAG);
    const $current = sh.qsd($progress, qt.CARTINFO.BOXSELECTION.PROGRESSBAR.CURRENTTAG);
    $span.style.left = `${-100 + (c.currentNum / c.pack.maxProducts) * 100}%`;
    $current.textContent = c.currentNum;
    if (sh.seq(c.currentNum, c.pack.maxProducts)) sh.addClass($progress, ct.ACTIVE);
    else sh.removeClass($progress, ct.ACTIVE);
    CanConfirm(handler);
  }
  function InitializeCartInfo(handler) {
    // Remove an existing cart-info element if found
    const existingCartInfo = handler.$loc.querySelector('[data-smartrr-cart-info]');
    if (existingCartInfo) {
      existingCartInfo.remove();
    }
    const p = handler.cart.pack;
    const c = handler.cart;
    const current = c.currentNum;
    const max = p.maxProducts;
    const cartInfoString = `
      <div data-smartrr-cart-info>
        <div data-smartrr-box-selection class="smartrr-active">
          <div data-smartrr-box-selection-progress-bar>
            <span data-smartrr-bspb-bar style="left: ${-100 + (c.currentNum / max)*100}%"></span>
            <div data-smartrr-bspb-full>
              <span><span data-smartrr-progress-current>${current}</span> of ${max} selected. Keep going!</span>
              <span>${intl().cartBoxFull}</span>
            </div>
          </div>
          <div data-smartrr-box-selection-cards class="smartrr-scrollbar"></div>
          <div data-smartrr-box-clear>
            <span>${SVGList.clearAllClose}</span>
            <span>${intl().cartClear}</span>
          </div>
        </div>
      </div>
    `;
    sh.addHTML(handler.$loc, cartInfoString);
    const $cartInfo = sh.qsd(handler.$loc, qt.CARTINFOTTAG);
    const $productList = sh.qsd($cartInfo, qt.CARTINFO.BOXSELECTION.CARDLISTTAG);
    GenerateCartProducts(handler, $productList);
    const $boxClear = sh.qsd($cartInfo, qt.CARTINFO.BOXSELECTION.BOXCLEARTAG);
    sh.click($boxClear, function () { Cart.ClearCart(handler); });
  }

  function GenerateCartProducts(handler, $productList) {
    const c = handler.cart;
    const p = handler.cart.pack;
    for (let index = 0; index < p.maxProducts; index++) {
      c.cartRefs.push(new ProductRef());
      GenerateVariant(handler, $productList, c.cartRefs[c.cartRefs.length - 1]);
    }
  }
  function InitializeConfirmation(handler) {
    const confirmationString = `
      <div data-smartrr-confirmation-container>
        <div data-smartrr-confirmation-cta>
          <span data-smartrr-ccta-text>${intl().cartConfirm} — </span>
          <span data-smartrr-ccta-price data-smartrr-bundle-price-amount></span>
        </div>
      </div>
    `;
    sh.addHTML(handler.$loc, confirmationString);
    const $confirmation = sh.qsd(handler.$loc, qt.CARTINFO.CONFIRMATIONTAG);
    const $cta = sh.qsd($confirmation, qt.CARTINFO.CONFIRMATION.CTATAG);
    sh.click($cta, function () { addBundleToCartAndRedirect(handler); });
    CanConfirm(handler);
  }
  function addBundleToCartAndRedirect(handler) {
    const c = handler.cart, b = handler.bundle;
    const bundleInfo = { items: [], date: new Date().getTime(), page: window.location.toString(), bundle: { name: b.name, slug: b.slug } };
    const properties = { "Bundle": b.name };
    Object.keys(c.lineItems).forEach(variantId => {
      const lineItem = c.lineItems[Number(variantId)];
      bundleInfo.items.push({ id: lineItem.variant.id, quantity: lineItem.quantity, selling_plan: c.sellingPlan });
      properties[`${lineItem.product.title} - ${lineItem.variant.title}`] = lineItem.quantity;
    });
    properties["_smartrr_info"] = JSON.stringify(bundleInfo);
    const formData = { items: [{ id: c.pack.buyWithVariant, quantity: 1, selling_plan: c.sellingPlan, properties: properties }] };
    fetch("/cart/add.js", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(formData) })
      .then(() => { window.location.href = "/cart"; });
  }
  function UpdatePrices(handler) {
    const c = handler.cart;
    const variantId = c.pack.buyWithVariant;
    const product = handler.bundle.bundleProduct;
    const sellingPlanId = c.sellingPlan || "";
    let price = 0;
    product.variants.forEach(variant => {
      if (sh.seq(variant.id, variantId)) {
        price = variant.price;
        variant.selling_plan_allocations.forEach(alloc => {
          if (sh.seq(alloc.selling_plan_id, sellingPlanId)) price = alloc.price;
        });
      }
    });
    const $prices = sh.qsad(handler.$loc, qt.PRICEINFO.PRICETAG);
    $prices.forEach($price => {
      $price.textContent = typeof Shopify !== "undefined"
        ? Intl.NumberFormat(Shopify.locale, { style: "currency", currency: Shopify.currency.active, minimumFractionDigits: 2 }).format(price / 100)
        : `$${price / 100}`;
    });
  }
  function CanConfirm(handler) {
    const c = handler.cart;
    const $confirmation = sh.checkqsd(handler.$loc, qt.CARTINFO.CONFIRMATIONTAG);
    const $sellingPlans = sh.checkqsd(handler.$loc, qt.CARTINFO.PLANSELECTIONTAG);
    const $plans = sh.qsad($sellingPlans, qt.CARTINFO.PLANSELECTION.PLANLIST.PLANTAG);
    if ($confirmation) {
      if (sh.seq(c.currentNum, c.pack.maxProducts)) {
        sh.addClass($sellingPlans, ct.ACTIVE);
        $plans.forEach($plan => { if (sh.containsClass($plan, ct.ACTIVE)) sh.addClass($confirmation, ct.ACTIVE); });
      } else {
        sh.removeClass([$confirmation, $sellingPlans], ct.ACTIVE);
      }
    }
    UpdatePrices(handler);
    return sh.seq(c.currentNum, c.pack.maxProducts);
  }
  function InitializeProductSelection(handler, $container) {
    const p = handler.cart.pack;
    const c = handler.cart;
    function GenerateSearchTags() {
      let tagString = "";
      p.searchFilter.searches.forEach(search => {
        tagString += `<div data-smartrr-psh-filter-tag="${btoa(search.searchTag)}">
          <div>${SVGList.searchTick}</div>
          <span>${search.displayTerm}</span>
        </div>`;
      });
      return tagString;
    }
    function GenerateProducts($productList) {
      p.collection.products.forEach(product => {
        for (const variant of product.variants) {
          variant.refs = new ProductRef();
          GenerateVariant(handler, $productList, variant.refs, variant, product);
        }
      });
    }
    const productSelectionString = `
      <div data-smartrr-product-selection>
        <div data-smartrr-product-selection-header>
          <div data-smartrr-psh-filter>
            <div data-smartrr-psh-filter-label><span>${intl().productSelectionFilterLabel(p.maxProducts - c.currentNum)}</span></div>
            <div data-smartrr-psh-filter-tags>
              <div data-smartrr-psh-filter-icon>${SVGList.searchFilter}</div>
              ${GenerateSearchTags()}
            </div>
          </div>
          <div data-smartrr-product-selection-search-container style="display: none;">
            <div data-smartrr-product-selection-search>
              <input placeholder="${intl().productSearchPlaceholder}">
              ${SVGList.searchIcon}
            </div>
            <div data-smartrr-product-search-mobile-cta>${SVGList.searchIcon}</div>
          </div>
        </div>
        <div data-smartrr-product-selection-list class="smartrr-scrollbar">
          <div data-smartrr-psl-empty class="${ct.HIDE}">${intl().productEmptySearch}</div>
        </div>
      </div>
    `;
    sh.addHTML($container, productSelectionString);
    const $productSelection = sh.qsd($container, qt.PRODUCTSELECTIONTAG);
    const $productList = sh.qsd($productSelection, qt.PRODUCTSELECTION.SELECTIONTAG);
    GenerateProducts($productList);
    InitializeCartInfo(handler);
    InitializeConfirmation(handler);
    UpdateProductSelection(handler);
    const $searchInput = sh.qs($productSelection, `[${qt.PRODUCTSELECTION.HEADER.SEARCH.SEARCHINPUTTAG}] input`);
    $searchInput.addEventListener("input", function () {
      const searchTerm = $searchInput.value;
      const $productEmptySearch = sh.qsd($productSelection, qt.PRODUCTSELECTION.SELECTION.EMPTYSEARCH);
      sh.removeClass($productEmptySearch, ct.HIDE);
      p.collection.products.forEach(product => {
        product.variants.forEach(variant => {
          if (variant.refs) sh.removeClass(variant.refs.$form, ct.HIDE);
          const productAndVariantTitle = `${product.title} - ${variant.title}`;
          if (!productAndVariantTitle.toLowerCase().includes(searchTerm.toLowerCase()))
            sh.addClass(variant.refs.$form, ct.HIDE);
          else
            sh.addClass($productEmptySearch, ct.HIDE);
        });
      });
    });
  }
  function reInitializeBundle() {
    $externalBundleLocation.innerHTML = `
      <div id="step1"></div>
      <div id="step2"></div>
      <div id="step3"></div>
      <div id="step4"></div>
    `;
    const handler = new Handler(externalBundleInformation, new Cart(), $externalBundleLocation);
    const bundle = handler.bundle;
    if (bundle.bundleProduct && bundle.bundleProduct.selling_plan_groups) {
      bundle.bundleProduct.selling_plan_groups.forEach(group => {
        if (sh.seq(btoa(group.options[0].name), bundle.groupName)) bundle.group = group;
      });
    }
    runSteps(handler);
    Log("Handler: ", handler);
  }
  try {
    reInitializeBundle();
  } catch (error) {
    console.error("Smartrr Bundle Fatal Error: ", error);
  }
}
</script>
<script>
if (["complete", "loaded"].indexOf(document.readyState) !== -1) {
  GenerateSmartrrBundle(SmartrrBundleInformation, document.querySelector('[data-smartrr-bundle-container]'));
} else {
  document.addEventListener("DOMContentLoaded", function () {
    GenerateSmartrrBundle(SmartrrBundleInformation, document.querySelector('[data-smartrr-bundle-container]'));
  });
}
</script>
