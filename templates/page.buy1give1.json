        "text_alignment": "left",
        "color_scheme": "2"
      }
    },
    "image_with_text_bhH6GE": {
      "type": "image-with-text",
      "blocks": {
        "subheading_X8GTF3": {
          "type": "subheading",
          "disabled": true,
          "settings": {
            "subheading": "Subheading"
          }
        },
        "heading_9ARaUE": {
          "type": "heading",
          "settings": {
            "title": "Started by Parents!",
            "use_h1": false
          }
        },
        "text_YMVND7": {
          "type": "text",
          "settings": {
            "text": "<p>We wanted to do better. </p><p>For our own kids. And for children whose families lacked the resources to help them easily get through life. </p><p>We wanted parents to have one less thing to worry about. And we wanted them to have more time for their children. </p><p>So, we quit our corporate jobs to make life a little easier for families.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "subheading_X8GTF3",
        "heading_9ARaUE",
        "text_YMVND7"
      ],
      "settings": {
        "image": "shopify://shop_images/About_Us_trio.png",
        "image_width": 700,
        "image_link": "",
        "image_position": "right",
        "text_alignment": "left",
        "color_scheme": "2"
      }
    },
    "image_with_text_MeDtRL": {
      "type": "image-with-text",
      "blocks": {
        "subheading_CtPAGN": {
          "type": "subheading",
          "disabled": true,
          "settings": {
            "subheading": "Subheading"
          }
        },
        "heading_wkH8bi": {
          "type": "heading",
          "settings": {
            "title": "The Meaning Behind Taare",
            "use_h1": false
          }
        },
        "text_zcGrkk": {
          "type": "text",
          "settings": {
            "text": "<p>\"Taare\" (pronounced: Taa-ray) means stars in the Hindi language. We chose this name as it represents the limitless potential we see in every child.</p><p>We are based out of Washington state. The region's natural beauty inspired our brand's commitment to sustainability by extending the life of worn shoes.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
