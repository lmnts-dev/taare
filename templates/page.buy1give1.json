      ],
      "settings": {
        "image": "shopify://shop_images/Taare_Gift.png",
        "image_width": 700,
        "image_link": "",
        "image_position": "right",
        "text_alignment": "left",
        "color_scheme": "2"
      }
    },
    "5d80e24d-359e-4497-b5e7-90275162de31": {
      "type": "image-with-text",
      "blocks": {
        "88949fd5-8250-4a34-9a66-e89dc0c91026": {
          "type": "subheading",
          "disabled": true,
