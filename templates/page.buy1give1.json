        "template--15213462618185__5d80e24d-359e-4497-b5e7-90275162de31-heading-1": {
          "type": "heading",
          "settings": {
            "title": "We help extend the life of shoes",
            "use_h1": false
          }
        },
        "template--15213462618185__5d80e24d-359e-4497-b5e7-90275162de31-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>By 15 months, on average. </p><p>With our free shipping labels and the support of our friends at Soles4Souls, gently used Taare shoes find new life around the world.</p><p>In the process, families that resell these shoes for a living are able to generate income and strengthen their community through sustainable entrepreneurship.</p><p>And when shoes are diverted away from landfills, the planet heals.</p><p>You can learn more about Soles4Souls and their 4Opportunity and 4Planet programs <a href=\"https://soles4souls.org/\" target=\"_blank\" title=\"https://soles4souls.org/\">here</a>.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "88949fd5-8250-4a34-9a66-e89dc0c91026",
        "template--15213462618185__5d80e24d-359e-4497-b5e7-90275162de31-heading-1",
        "template--15213462618185__5d80e24d-359e-4497-b5e7-90275162de31-text-1"
      ],
