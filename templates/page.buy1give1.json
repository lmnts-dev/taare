      }
    },
    "image_with_text_jVX7dm": {
      "type": "image-with-text",
      "blocks": {
        "subheading_GrpQPz": {
          "type": "subheading",
          "disabled": true,
          "settings": {
            "subheading": "Subheading"
          }
        },
        "heading_MpFedh": {
          "type": "heading",
          "settings": {
            "title": "No Adults Allowed",
            "use_h1": false
          }
        },
        "text_epz9aG": {
          "type": "text",
          "settings": {
            "text": "<p>Sorry parents, no shoes for your size. We make shoes only for children. </p><p>That focus helps us create some of the most comfortable shoes you can find for your child.</p>",
            "enlarge_text": false
          }
        }
      },
